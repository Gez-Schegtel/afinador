{
  "name": "afinador",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Endurend Musical Gadgets: afinador cromático estilo pedal (< 0.05 cents), afinaciones, diccionario e identificador de acordes y metrónomo para guitarra y bajo. Libre y offline.",
  "homepage": "https://gez-schegtel.github.io/afinador/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gez-Schegtel/afinador.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest",
    "cap:sync": "npm run build && npx cap sync android",
    "android:usb": "adb reverse tcp:5173 tcp:5173 && echo 'Puerto 5173 reenviado por USB. Abrí http://localhost:5173 en el navegador de tu Android.'",
    "bench": "VITE_BENCH=1 vitest run src/core/dsp/mpm.perf.test.ts --reporter=verbose --silent=false"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
